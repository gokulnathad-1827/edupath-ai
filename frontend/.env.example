VITE_CAREER_URL=https://<RENDER_CAREER_SERVICE_URL>
VITE_COURSE_URL=https://<RENDER_COURSE_SERVICE_URL>
VITE_AI_URL=https://<RENDER_AI_SERVICE_URL>
VITE_API_BASE_URL=https://<RENDER_AUTH_SERVICE_URL>/api
